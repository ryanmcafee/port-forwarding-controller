# This file defines the Kubebuilder project configuration
# Migrated from version 1 to version 3 (go.kubebuilder.io/v4)
version: "3"
domain: github.com
repo: github.com/ryanmcafee/port-forwarding-controller
projectName: port-forwarding-controller
layout:
- go.kubebuilder.io/v4
# This controller watches core Kubernetes Services (not custom CRDs)
# and manages port forwarding rules on UniFi routers based on annotations
resources:
- controller: true
  domain: ""
  group: ""
  kind: Service
  path: k8s.io/api/core/v1
  version: v1
